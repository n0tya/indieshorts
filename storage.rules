rules_version = '2';

// INDIE SHORTS - Storage セキュリティルール
// 反映方法: Firebaseコンソール > Storage > ルール に貼り付けて「公開」
//           または `firebase deploy --only storage`
service firebase.storage {
  match /b/{bucket}/o {

    function isValidImage() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|gif|webp)');
    }

    // 既存（旧パス）の画像も含めて閲覧は誰でも可
    match /thumbnails/{allPaths=**} {
      allow read: if true;
    }
    match /avatars/{allPaths=**} {
      allow read: if true;
    }

    // 新規アップロードは自分の uid フォルダにのみ、画像・5MB未満・新規作成のみ
    match /thumbnails/{uid}/{fileName} {
      allow create: if request.auth != null && request.auth.uid == uid && isValidImage();
    }
    match /avatars/{uid}/{fileName} {
      allow create: if request.auth != null && request.auth.uid == uid && isValidImage();
    }
  }
}
